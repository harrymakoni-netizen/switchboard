{
  "name": "switchboard",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsc --noEmit && pnpm --filter web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "dev": "concurrently -k \"pnpm --filter web dev\" \"tsx --env-file=.env apps/worker/src/index.ts\"",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "e2e:mock": "playwright test",
    "paypal:smoke": "tsx scripts/paypal-smoke.ts",
    "twilio:smoke": "tsx scripts/twilio-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.109",
    "@onkernel/sdk": "^0.140.0",
    "@paypal/agent-toolkit": "1.11.0",
    "ai": "^7.0.159",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.44.0",
    "pg-boss": "^10.3.0",
    "postgres": "^3.4.5",
    "twilio": "6.2.0",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": "24.x"
  }
}
